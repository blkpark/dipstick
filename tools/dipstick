def apply_lang(db, override=None):
    global LANG
    LANG = override or get_setting(db, "lang", "ko") or "ko"
    if LANG not in ("ko", "en"):
        LANG = "ko"


def render_html(db, rows, consumers, path=None, interactive=False):
    main = get_setting(db, "main")
    groups = group_by_subscription(rows, main)
    states = [w["verdict"][0] for _, _, g in groups
              for w in binding_windows([w2 for r in g for w2 in r["windows"]])]
    # a subscription with no readable window is UNKNOWN, not "여유"
    states += ["UNKNOWN" for _, _, g in groups if not any(r["windows"] for r in g)]
    worst = next((s for s in STATE_ORDER if s in states), "UNKNOWN")
    worst_text = {
        "GO": L("모든 구독 여유", "every subscription has headroom"),
        "TIGHT": L("일부 구독 빠듯 — 긴 작업 주의", "some are tight — mind long jobs"),
        "LOW": L("잔량 부족 구독 있음", "a subscription is running low"),
        "BLOCKED": L("소진된 구독 있음", "a subscription is exhausted"),
        "STALE": L("관측이 오래된 구독 있음", "a reading is stale"),
        "UNKNOWN": L("못 읽은 구독 있음 — 카드 확인", "a subscription could not be read"),
    }[worst]
    selectable = {sub for sub, _, _ in groups if not sub.startswith("Antigravity")}

    # the subscription being burned below its own reserve floor, if any. This is
    # surfaced here rather than on stderr: --main-cmd runs inside a command
    # substitution, where a warning is swallowed by the launch line.
    over = next((sub for sub, _, g in groups if sub == main
                 and (reserve_state(sub, [w for r in g for w in r["windows"]], True)
                      or ("", ""))[0] == "LOW"), None)
    langsw = ('<div class="langsw" role="group" aria-label="Language">'
              + "".join(f'<a class="{"on" if LANG == code else ""}" href="/?lang={code}"'
                        + (' aria-current="true"' if LANG == code else "")
                        + f'>{name}</a>'
                        for code, name in (("ko", "한국어"), ("en", "EN")))
              + '</div>')
    warnbar = (f'<span class="warnbar status" data-s="LOW">{icon("TIGHT")}<span>'
               + esc(L(f"{over} — 예비 아래를 태우는 중. 이 구독을 직접 쓰는 작업이 먼저 끊길 수 있다",
                       f"{over} — burning below its reserve; "
                       "your own use of this plan may stop first"))
               + '</span></span>') if over else ""

    mode = get_setting(db, "main_mode", "weighted")
    pick, pick_why = pick_launch(db, rows)
    modesw = ""
    if interactive:
        other = "pinned" if mode == "weighted" else "weighted"
        label = (L("무조건 메인", "Pinned") if mode == "weighted"
                 else L("가중으로", "Weighted"))
        modesw = (f'<form class="modesw" method="post" action="/mode">'
                  f'<input type="hidden" name="mode" value="{other}">'
                  f'<button type="submit" title="{esc(L("발사 구독 선택 방식 전환", "toggle launch selection"))}">'
                  f'{label}</button></form>')
    p = [f'<header><h1>lane dispatch gauge</h1>'
         f'<span class="stamp">{now:%Y-%m-%d %H:%M} · '
         + L("메인 ", "main ")
         + f'{esc(main or L("미지정", "unset"))}'
         + (" · " + (L("무조건 메인", "pinned") if mode == "pinned" else L("가중", "weighted")))
         + (f' · {L("다음 발사", "next")}: <b>{esc(pick)}</b>' if pick else "")
         + '</span>'
         + modesw + langsw + warnbar
         + f'<span class="headline status" data-s="{worst}">{icon(worst)}'
           f'<span><span class="tag">{worst}</span> {esc(worst_text)}</span></span></header>'
           f'<div class="wrap"><div class="grid">']

    for sub, account, group in groups:
        is_main = sub == main
        p.append(f'<section class="card{" ismain" if is_main else ""}"><div class="card-head">'
                 f'<span class="sub">{vendor_icon(sub)}{esc(sub)}'
                 f'{f'<span class="mainbadge">{L("메인", "MAIN")}</span>' if is_main else ""}</span>'
                 f'<span class="who">{esc(account)}</span></div>')
        pol = policy_of(sub)
        if pol:
            p.append(f'<div class="policy"><b>{esc(pol[0])}</b> {esc(pol[1])}</div>')
        rs = reserve_state(sub, [w for r in group for w in r["windows"]], is_main)
        if rs:
            p.append(f'<div class="reserve status" data-s="{rs[0]}">{icon(rs[0])}'
                     f'<span>{esc(rs[1])}</span></div>')
        bind = binding_window([w for r in group for w in r["windows"]])
        for r in group:
            if r.get("pool"):
                p.append(f'<div class="pool">{esc(r["pool"])}</div>')
            for w in r["windows"]:
                state, why = w["verdict"]
                rate = burn_rate(db, sub, w["name"])
                soon = is_imminent(w.get("resets"))
                if w["resets"]:
                    when, left = fmt_reset(w["resets"])
                    reset_row = (f'<div class="resetrow{" soon" if soon else ""}">'
                                 f'<span class="rlabel">{L("회복", "resets")}</span>'
                                 f'<span class="rwhen">{esc(when)}</span>'
                                 f'<span class="rleft">{esc(left)}</span></div>')
                else:
                    reset_row = ""
                pace = (f'<div class="pace">{L("소모", "burn")} {rate:.1f}%p/h</div>' if rate else "")
                p.append(
                    f'<div class="win" data-s="{state}">'
                    f'<div class="win-head"><span class="win-name">{esc(w["name"])}'
                    + (f'<span class="soonchip">{L("회복 임박", "recovering")}</span>' if soon
                       else f'<span class="bindchip">{L("제약", "binds")}</span>'
                       if w is bind and state != "GO" else '') +
                    f'</span><span class="pct">{w["remaining"]:.0f}%</span></div>'
                    f'<div class="bar"><i style="width:{max(0, min(100, w["remaining"])):.0f}%"></i></div>'
                    f'<div class="status">{icon(state)}<span><span class="tag">{state}</span> '
                    f'{esc(why)}</span></div>{reset_row}{pace}</div>')
            if r.get("note"):
                p.append(f'<div class="note">{esc(r["note"])}</div>')
        if interactive and sub in selectable:
            over = bool(rs and rs[0] == "BLOCKED")
            target = "auto" if is_main else sub_key(sub)
            p.append(f'<form class="pick" method="post" action="/main">'
                     f'<input type="hidden" name="key" value="{target}">'
                     f'<button type="submit">'
                     f'{L("메인 해제", "Unset main") if is_main else L("메인으로 지정", "Set as main")}</button>'
                     + (f'<span class="hint">{L("하한 아래 — 지정하면 태운다", "below the floor — setting it burns through")}</span>' if over else "")
                     + '</form>')
        p.append("</section>")

    p.append(f'<section class="card"><div class="card-head">'
             f'<span class="sub">{L("실행 중인 codex", "running codex")}</span>'
             f'<span class="who">{sum(consumers.values())}' + L("개 프로세스", " processes") + '</span></div>'
             '<table><thead><tr><th scope="col">CODEX_HOME</th>'
             f'<th scope="col" style="text-align:right">{L("수", "count")}</th></tr></thead><tbody>')
    if not consumers:
        p.append(f'<tr><td class="p">{L("없음", "none")}</td><td class="n">0</td></tr>')
    for home, n in consumers.most_common():
        p.append(f'<tr><td class="p">{esc(home.replace(os.path.expanduser("~"), "~"))}</td>'
                 f'<td class="n">{n}</td></tr>')
    p.append("</tbody></table></section></div>")

    p.append('<footer>'
             + L('출처 — Codex: 세션 롤아웃 <code>rate_limits</code> · '
                 'Claude: <code>/api/oauth/usage</code> · agy: 로컬 language server RPC. ',
                 'Sources — Codex: session rollout <code>rate_limits</code> · '
                 'Claude: <code>/api/oauth/usage</code> · agy: local language server RPC. ')
             + (L("새로고침하면 갱신", "refresh to update") if interactive
                else L("갱신은 스크립트 재실행", "re-run the script to update"))
             + L('.<br>계측 전용 — 어떤 소스도 모델에 프롬프트를 보내지 않으므로 quota 를 '
                 '소모하지 않는다. 메인은 사람이 정하는 설정이며 이 도구는 아무것도 실행하지 않는다.',
                 '.<br>Metering only — no source sends a prompt to a model, so none of this '
                 'spends quota. The main is your setting; this tool runs nothing itself.')
             + '</footer></div>')

    doc = (f'<!doctype html><html lang="{LANG}"><head><meta charset="utf-8">'
           '<meta name="viewport" content="width=device-width,initial-scale=1">'
           f'<title>lane dispatch gauge</title><style>' + CSS + '</style></head>'
           '<body>' + "".join(p) + '</body></html>')
    if path:
        with open(path, "w", encoding="utf-8") as f:
            f.write(doc)
    return doc


# ------------------------------------------------------------------- serve

def serve(port):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, code, body, ctype="text/html; charset=utf-8", extra=None):
            data = body.encode() if isinstance(body, str) else body
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            for k, v in (extra or {}).items():
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            if parsed.path not in ("/", "/index.html"):
                return self._send(404, "not found", "text/plain; charset=utf-8")
            global now
            now = datetime.datetime.now()
            db = connect()
            try:
                want = (urllib.parse.parse_qs(parsed.query).get("lang") or [""])[0]
                if want in ("ko", "en"):
                    set_setting(db, "lang", want)
                apply_lang(db)
                rows, consumers = collect(db)
                self._send(200, render_html(db, rows, consumers, interactive=True))
            finally:
                db.close()

        def do_POST(self):
            if self.path == "/mode":
                n = int(self.headers.get("Content-Length") or 0)
                want = (urllib.parse.parse_qs(self.rfile.read(n).decode()).get("mode") or [""])[0]
                db = connect()
                try:
                    if want in ("pinned", "weighted"):
                        set_setting(db, "main_mode", want)
                finally:
                    db.close()
                return self._send(303, b"", "text/plain", {"Location": "/"})
            if self.path != "/main":
                return self._send(404, "not found", "text/plain; charset=utf-8")
            n = int(self.headers.get("Content-Length") or 0)
            key = (urllib.parse.parse_qs(self.rfile.read(n).decode()).get("key") or [""])[0]
            db = connect()
            try:
                if key == "auto":
                    set_setting(db, "main", "")
                else:
                    rows, _ = collect(db)
                    hit = next((r["sub"] for r in rows if sub_key(r["sub"]) == key), "")
                    set_setting(db, "main", hit)
            finally:
                db.close()
            self._send(303, b"", "text/plain", {"Location": "/"})

    httpd = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    print(f"lane dispatch gauge — http://127.0.0.1:{port}/   (Ctrl-C 로 종료)")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n종료")
    return 0


