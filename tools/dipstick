def render_text(db, rows, consumers):
    main = get_setting(db, "main")
    mode = get_setting(db, "main_mode", "weighted")
    pick, why = pick_launch(db, rows)
    print(f"== lane dispatch gauge  {now:%Y-%m-%d %H:%M} ==")
    print(L("   메인: ", "   main: ") + (main or L("미지정", "unset"))
          + f"  ·  {L('모드', 'mode')}: " + (L("무조건 메인", "pinned") if mode == "pinned" else L("가중", "weighted")))
    print(L("   다음 발사: ", "   next launch: ") + (pick or "?") + f"  ({why})\n")
    for sub, account, group in group_by_subscription(rows, main):
        print(f"┌ {sub}   ({account}){(L('   ★ 메인', '   * MAIN') if sub == main else '')}")
        pol = policy_of(sub)
        if pol:
            print(f"    ({pol[0]}) {pol[1]}")
        rs = reserve_state(sub, [w for r in group for w in r["windows"]], sub == main)
        if rs:
            print(f"    [{rs[0]}] {rs[1]}")
        bind = binding_window([w for r in group for w in r["windows"]])
        for r in group:
            if r.get("pool"):
                print(f"  {r['pool']}")
            for w in r["windows"]:
                state, why = w["verdict"]
                rate = burn_rate(db, sub, w["name"])
                sur = w.get("surplus")
                print(f"    {w['name']}: " + L("잔량 ", "left ") + f"{w['remaining']:.0f}%"
                      + (f" ({sur:+.0f}%p)" if sur is not None else "")
                      + (L("  [회복 임박]", "  [recovering]") if is_imminent(w.get("resets"))
                         else L("  [제약]", "  [binds]") if w is bind and w["verdict"][0] != "GO" else "")
                      + (L(f"  (소모 {rate:.1f}%p/h)", f"  (burn {rate:.1f}%p/h)") if rate else ""))
                if w["resets"]:
                    when, left = fmt_reset(w["resets"])
                    print("      " + L("회복 ", "resets ") + f"{when}  ({left})")
                print(f"      -> {state}: {why}")
            if r.get("note"):
                print(f"    {r['note']}")
        print()
    print(L("[실행 중인 codex]", "[running codex]"))
    if not consumers:
        print(L("  없음", "  none"))
    for home, n in consumers.most_common():
        print(f"  {n}x  {home.replace(os.path.expanduser('~'), '~')}")


