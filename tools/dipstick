now = datetime.datetime.now()


def hours_until(dt):
    return (dt - now).total_seconds() / 3600


WEEKDAY = "월화수목금토일"


def fmt_left(secs):
    """Spoken duration -- '3시간 3분 후', never a bare decimal like '3.1h'."""
    if secs < 0:
        return L("지남 · 갱신 대기", "past · awaiting refresh")
    mins = int(secs // 60)
    if mins < 1:
        return L("곧", "any moment")
    if mins < 60:
        return L(f"{mins}분 후", f"in {mins}m")
    h, m = divmod(mins, 60)
    if h < 24:
        return L(f"{h}시간 {m}분 후" if m else f"{h}시간 후",
                 f"in {h}h {m}m" if m else f"in {h}h")
    d, h = divmod(h, 24)
    return L(f"{d}일 {h}시간 후" if h else f"{d}일 후",
             f"in {d}d {h}h" if h else f"in {d}d")


def fmt_reset(dt):
    """(when, left) -- '오늘 19:00', '3시간 6분 후'.

    The reset clock is half of every decision here, so it gets a calendar-relative
    day and a spoken duration instead of a bare decimal like '3.1h'.
    """
    days = (dt.date() - now.date()).days
    if LANG == "ko":
        day = ("오늘" if days == 0 else "내일" if days == 1 else "모레" if days == 2
               else f"{dt:%m-%d}({WEEKDAY[dt.weekday()]})")
    else:
        day = ("today" if days == 0 else "tomorrow" if days == 1
               else f"{dt:%b %d (%a)}")
    when = f"{day} {dt:%H:%M}"

    return when, fmt_left((dt - now).total_seconds())


def pace_surplus(remaining, minutes, resets):
    """%p above (+) or below (-) the sustainable line.

    The line is where the reading would sit if the window were being spent at a
    perfectly even rate: time-left fraction of the window. 94% right after a
    weekly reset is level pace, not headroom; 40% the day before one is plenty.
    """
    if not minutes or not resets:
        return None
    left_h = hours_until(resets)
    if left_h <= 0:
        return None
    line = min(100.0, 100.0 * left_h / (minutes / 60.0))
    return remaining - line


def tier(remaining_pct):
    for floor, tag, colour in TIERS:
        if remaining_pct >= floor:
            return tag, colour
    return "BLOCKED", "#b3382f"


def verdict(remaining_pct, hours_left, stale_hours=0.0, live=0, imminent=False, surplus=None):
    left = fmt_left(hours_left * 3600)
    if remaining_pct is None:
        return "UNKNOWN", L("관측값 없음 — 수동 확인", "no reading — check manually")
    if stale_hours > STALE_HOURS:
        return "STALE", L(f"마지막 관측 {stale_hours:.0f}h 전 — 실제 잔량은 더 낮을 수 있음",
                          f"last seen {stale_hours:.0f}h ago — the real figure may be lower")
    busy = L(f" · 같은 풀에 실행 중 {live}개", f" · {live} running on this pool") if live else ""
    if surplus is not None and remaining_pct > 0.01 and not imminent:
        # Graded against pace, not against a fixed percentage: how far the reading
        # sits from where an even spend would have it, so a fresh window never
        # reads as abundance and a nearly-over one never reads as famine.
        if surplus >= 10:
            return "GO", L(f"페이스 여유 {surplus:+.0f}%p{busy}",
                           f"ahead of pace {surplus:+.0f}%p{busy}")
        if surplus >= -10:
            return "TIGHT", L(f"정속 부근 {surplus:+.0f}%p — 긴 작업 주의{busy}",
                              f"about level pace {surplus:+.0f}%p — mind long jobs{busy}")
        return "LOW", L(f"페이스 초과 {surplus:+.0f}%p — {left} 회복까지 신규 작업 보류{busy}",
                        f"over pace {surplus:+.0f}%p — hold new work until it recovers {left}{busy}")
    tag, _ = tier(remaining_pct)
    if imminent and tag != "GO":
        return tag, L(f"회복 임박 — {left} 풀린다. 지금 시작할 작업엔 제약 아님{busy}",
                      f"recovers {left} — not a constraint for work you start now{busy}")
    if tag == "BLOCKED":
        return tag, L(f"소진 — {left} 회복", f"exhausted — recovers {left}")
    if tag == "LOW":
        return tag, L(f"{left} 회복까지 신규 작업 보류{busy}",
                      f"hold new work until it recovers {left}{busy}")
    if tag == "TIGHT":
        return tag, L(f"짧은 작업만 — 긴 작업은 {left} 회복 이후로{busy}",
                      f"short work only — leave long work until it recovers {left}{busy}")
    return tag, L(f"여유{busy}", f"headroom{busy}")


def is_imminent(resets):
    if not resets:
        return False
    return 0 <= (resets - now).total_seconds() / 60 <= IMMINENT_MIN


def binding_windows(windows):
    """The windows that actually constrain a new lane.

    Falls back to everything when every window is about to reset, so a card is
    never summarised from an empty set.
    """
    lasting = [w for w in windows if not is_imminent(w.get("resets"))]
    return lasting or windows


def binding_window(windows):
    """The single window a card's verdict comes from, or None.

    Labelling it is the point: without it the weighting is invisible and a reader
    still assumes the smallest number is the problem.
    """
    wins = binding_windows(windows)
    return min(wins, key=lambda w: w["remaining"]) if wins else None


def binding_score(windows):
    wins = binding_windows(windows)
    return min((w["remaining"] for w in wins), default=101.0)


def policy_of(sub):
    return next((v for k, v in POLICY.items() if sub.startswith(k)), None)


def reserve_floor(sub):
    return next((v for k, v in RESERVE.items() if sub.startswith(k)), None)


def reserve_state(sub, windows, is_main=False):
    floor = reserve_floor(sub)
    if floor is None:
        return None
    vals = [w["remaining"] for w in windows]
    if not vals:
        return "UNKNOWN", L(f"관측값 없음 — 하한 {floor:.0f}% 확인 불가",
                            f"no reading — cannot check the {floor:.0f}% floor")
    low = min(vals)
    if low < floor:
        worst = min(windows, key=lambda w: w["remaining"])
        left = fmt_left((worst["resets"] - now).total_seconds()) if worst.get("resets") else ""
        soon = (L(f" · {left} 회복", f" · recovers {left}")
                if is_imminent(worst.get("resets")) else "")
        if is_main:
            return "LOW", L(f"잔량 {low:.0f}% < 예비 {floor:.0f}% — 메인 지정으로 태우는 중. "
                            f"이 구독을 직접 쓰는 작업이 먼저 끊길 수 있다{soon}",
                            f"{low:.0f}% left, below the {floor:.0f}% reserve — burning it by "
                            f"explicit choice. Your own use of this plan may stop first{soon}")
        return "BLOCKED", L(f"잔량 {low:.0f}% < 예비 {floor:.0f}% — 사용 보류. "
                            f"태우려면 메인으로 지정한다{soon}",
                            f"{low:.0f}% left, below the {floor:.0f}% reserve — on hold. "
                            f"Set it as main to burn through{soon}")
    when = (L("메인 지정됨 — 지금 배정 가능", "set as main — assignable now") if is_main
            else L("마감 임박 시 배정 가능", "assignable under deadline pressure"))
    return "GO", L(f"하한 {floor:.0f}%까지 여유 {low - floor:.0f}%p — {when}",
                   f"{low - floor:.0f}%p above the {floor:.0f}% floor — {when}")


