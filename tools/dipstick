def window_label(minutes):
    if minutes % 10080 == 0 and minutes >= 10080:
        n = minutes // 10080
        return L(f"{n}주 창" if n > 1 else "7일 창",
                 f"{n}-week window" if n > 1 else "7-day window")
    if minutes % 1440 == 0:
        n = minutes // 1440
        return L(f"{n}일 창", f"{n}-day window")
    return L(f"{minutes // 60}시간 창", f"{minutes // 60}-hour window")


