            p.append('</div>')
        if interactive and sub in selectable:
            over = bool(rs and rs[0] == "BLOCKED")
            target = "auto" if is_main else sub_key(sub)
            p.append(f'<form class="pick" method="post" action="/main">'
                     f'<input type="hidden" name="key" value="{target}">'
                     f'<button type="submit">'
                     f'{L("메인 해제", "Unset main") if is_main else L("메인으로 지정", "Set as main")}</button>'
                     + (f'<span class="hint">{L("하한 아래 — 지정하면 태운다", "below the floor — setting it burns through")}</span>' if over else "")
                     + '</form>')
        p.append("</section>")

    p.append(f'<section class="card"><div class="card-head">'
             f'<span class="sub">{L("실행 중인 codex", "running codex")}</span>'
             f'<span class="who">{sum(consumers.values())}' + L("개 프로세스", " processes") + '</span></div>'
             '<table><thead><tr><th scope="col">CODEX_HOME</th>'
             f'<th scope="col" style="text-align:right">{L("수", "count")}</th></tr></thead><tbody>')
    if not consumers:
        p.append(f'<tr><td class="p">{L("없음", "none")}</td><td class="n">0</td></tr>')
    for home, n in consumers.most_common():
        p.append(f'<tr><td class="p">{esc(home.replace(os.path.expanduser("~"), "~"))}</td>'
                 f'<td class="n">{n}</td></tr>')
    p.append("</tbody></table></section></div>")

    p.append('<footer>'
             + L('출처 — Codex: 세션 롤아웃 <code>rate_limits</code> · '
                 'Claude: <code>/api/oauth/usage</code> · agy: 로컬 language server RPC. ',
                 'Sources — Codex: session rollout <code>rate_limits</code> · '
                 'Claude: <code>/api/oauth/usage</code> · agy: local language server RPC. ')
             + (L("새로고침하면 갱신", "refresh to update") if interactive
                else L("갱신은 스크립트 재실행", "re-run the script to update"))
             + L('.<br>계측 전용 — 어떤 소스도 모델에 프롬프트를 보내지 않으므로 quota 를 '
                 '소모하지 않는다. 메인은 사람이 정하는 설정이며 이 도구는 아무것도 실행하지 않는다.',
                 '.<br>Metering only — no source sends a prompt to a model, so none of this '
                 'spends quota. The main is your setting; this tool runs nothing itself.')
             + '</footer></div>')

    doc = (f'<!doctype html><html lang="{LANG}"><head><meta charset="utf-8">'
           '<meta name="viewport" content="width=device-width,initial-scale=1">'
           f'<title>lane dispatch gauge</title><style>' + CSS + '</style></head>'
           '<body>' + "".join(p) + '</body></html>')
    if path:
        with open(path, "w", encoding="utf-8") as f:
            f.write(doc)
    return doc


# ------------------------------------------------------------------- serve

def serve(port):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, code, body, ctype="text/html; charset=utf-8", extra=None):
            data = body.encode() if isinstance(body, str) else body
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            for k, v in (extra or {}).items():
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            if parsed.path not in ("/", "/index.html"):
                return self._send(404, "not found", "text/plain; charset=utf-8")
            global now
            now = datetime.datetime.now()
            db = connect()
            try:
                want = (urllib.parse.parse_qs(parsed.query).get("lang") or [""])[0]
                if want in ("ko", "en"):
                    set_setting(db, "lang", want)
                apply_lang(db)
                rows, consumers = collect(db)
                self._send(200, render_html(db, rows, consumers, interactive=True))
            finally:
                db.close()

        def do_POST(self):
            if self.path == "/mode":
                n = int(self.headers.get("Content-Length") or 0)
                want = (urllib.parse.parse_qs(self.rfile.read(n).decode()).get("mode") or [""])[0]
                db = connect()
                try:
                    if want in ("pinned", "weighted"):
                        set_setting(db, "main_mode", want)
                finally:
                    db.close()
                return self._send(303, b"", "text/plain", {"Location": "/"})
            if self.path != "/main":
                return self._send(404, "not found", "text/plain; charset=utf-8")
            n = int(self.headers.get("Content-Length") or 0)
            key = (urllib.parse.parse_qs(self.rfile.read(n).decode()).get("key") or [""])[0]
            db = connect()
            try:
                if key == "auto":
                    set_setting(db, "main", "")
                else:
                    rows, _ = collect(db)
                    hit = next((r["sub"] for r in rows if sub_key(r["sub"]) == key), "")
                    set_setting(db, "main", hit)
            finally:
                db.close()
            self._send(303, b"", "text/plain", {"Location": "/"})

    httpd = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    print(f"lane dispatch gauge — http://127.0.0.1:{port}/   (Ctrl-C 로 종료)")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n종료")
    return 0


# --------------------------------------------------------------------- cli

def main(argv):
    args = argv[1:]
    db = connect()
    try:
        if "--lang" in args:
            i = args.index("--lang")
            want = args[i + 1] if len(args) > i + 1 else ""
            if want not in ("ko", "en"):
                print("사용: --lang ko|en", file=sys.stderr)
                return 2
            set_setting(db, "lang", want)
            print(f"lang = {want}")
            return 0
        load_config()
        apply_lang(db)
        if "--set-main" in args:
            i = args.index("--set-main")
            key = args[i + 1] if len(args) > i + 1 else ""
            if key == "auto":
                set_setting(db, "main", "")
                print(L("메인 해제", "main cleared"))
                return 0
            rows, _ = collect(db)
            hit = next((r["sub"] for r in rows if sub_key(r["sub"]) == key), None)
            if not hit:
                keys = sorted({sub_key(r["sub"]) for r in rows})
                print("usage: --set-main " + "|".join(keys + ["auto"]), file=sys.stderr)
                return 2
            set_setting(db, "main", hit)
            print(L(f"메인 = {hit}", f"main = {hit}"))
            return 0

        if "--main-mode" in args:
            i = args.index("--main-mode")
            want = args[i + 1] if len(args) > i + 1 else ""
            if want not in ("pinned", "weighted"):
                cur = get_setting(db, "main_mode", "weighted")
                print(f"main-mode = {cur}  (사용: --main-mode pinned|weighted)")
                return 0
            set_setting(db, "main_mode", want)
            print(L(f"main-mode = {want}" + (" — 한 구독만 태운다" if want == "pinned"
                                             else " — 페이스 가중 선택"),
                    f"main-mode = {want}"))
            return 0

        if "--bar-window" in args:
            i = args.index("--bar-window")
            want = args[i + 1] if len(args) > i + 1 else ""
            if want not in BAR_WINDOWS:
                cur = get_setting(db, "bar_window", "binds")
                print(f"bar-window = {cur}  (사용: --bar-window {'|'.join(BAR_WINDOWS)})")
                return 0
            set_setting(db, "bar_window", want)
            print(L(f"bar-window = {want}", f"bar-window = {want}"))
            return 0

        if "--statusline" in args:
            # One line for a shell prompt or tmux bar: per subscription, the
            # figure of whichever window the menu bar leads with, coloured only
            # when something is actually wrong. Prompts redraw constantly, so
            # this must stay instant and quiet -- it reads whatever the last
            # refresh knew and never blocks on the network (the app or any
            # normal run keeps that fresh).
            rows, _ = collect(db)
            bar = get_setting(db, "bar_window", "binds")
            main_name = get_setting(db, "main")
            plain = "--no-color" in args or not sys.stdout.isatty()
            parts = []
            for sub, account, group in group_by_subscription(rows, main_name):
                wins = [w for r in group for w in r["windows"]]
                if not wins:
                    continue
                win = None
                if bar != "binds":
                    target = 300 if bar == "5h" else 10080
                    scoped = [w for w in wins if w.get("minutes") == target]
                    win = next((w for w in scoped if not w.get("pool")),
                               scoped[0] if scoped else None)
                if win is None:
                    win = next((w for w in wins if w.get("binds")), None)                         or min(wins, key=lambda w: w["remaining"])
                label = sub.split()[-1] if sub.split()[-1] != sub.split()[0] else sub.split()[0]
                state = win["verdict"][0]
                stale = state == "STALE"
                pct = f"{win['remaining']:.0f}%" + ("?" if stale else "")
                if not plain and state in ("LOW", "BLOCKED"):
                    color = "31" if state == "BLOCKED" else "33"
                    pct = f"\033[{color}m{pct}\033[0m"
                star = "*" if sub == main_name else ""
                parts.append(f"{label}{star} {pct}")
            print(" | ".join(parts) if parts else "dipstick: no readings")
            return 0

        if "--main-cmd" in args:
            vendor = None
            if "--vendor" in args:
                i = args.index("--vendor")
                vendor = args[i + 1] if len(args) > i + 1 else None
            rows, _ = collect(db)
            cmd, err, warn = main_launch_cmd(db, rows, vendor)
            if err:
                print(err, file=sys.stderr)
                return 1
            print(cmd)
            return 0

        if "--serve" in args:
            i = args.index("--serve")
            port = int(args[i + 1]) if len(args) > i + 1 and args[i + 1].isdigit() else 8787
            db.close()
            return serve(port)

        rows, consumers = collect(db)
        if "--json" in args:
            main = get_setting(db, "main")
            pick, pick_why = pick_launch(db, rows)
            print(json.dumps({
                "takenAt": now.isoformat(timespec="seconds"),
                "main": main,
                "mainMode": get_setting(db, "main_mode", "weighted"),
                # Which window the menu bar puts up front. "binds" keeps the
                # old behaviour -- whichever window actually constrains work --
                # while 5h/7d pin one horizon so the figures stay comparable
                # across subscriptions instead of switching axis per column.
                "barWindow": get_setting(db, "bar_window", "binds"),
                "nextLaunch": pick, "nextLaunchWhy": pick_why,
                "subscriptions": [
                    {"sub": sub, "key": sub_key(sub), "account": account,
                     "isMain": sub == main,
                     "selectable": not sub.startswith("Antigravity"),
                     "reserve": (lambda rs: {"state": rs[0], "text": rs[1]} if rs else None)(
                         reserve_state(sub, [w for r in g for w in r["windows"]], sub == main)),
                     "windows": [
                         {"name": w["name"], "pool": r.get("pool"),
                          "remaining": round(w["remaining"], 1),
                          "surplus": round(w["surplus"], 1) if w.get("surplus") is not None else None,
                          "state": w["verdict"][0], "why": w["verdict"][1],
                          "resetsAt": w["resets"].isoformat() if w["resets"] else None,
                          "resetsIn": (fmt_left((w["resets"] - now).total_seconds())
                                       if w["resets"] else ""),
                          "minutes": w.get("minutes"),
                          "imminent": is_imminent(w.get("resets")),
                          "binds": w is binding_window([w2 for r2 in g for w2 in r2["windows"]])}
                         for r in g for w in r["windows"]],
                     "note": next((r["note"] for r in g if r.get("note")), "")}
                    for sub, account, g in group_by_subscription(rows, main)],
                "runningCodex": [{"home": h, "count": n} for h, n in consumers.most_common()],
                # the menu bar app renders these verbatim so one language holds
                # across the CLI, the web UI and the menu
                "lang": LANG,
                "strings": {
                    "setAsMain": L("메인으로 지정", "Set as main"),
                    "unsetMain": L("메인 해제", "Unset as main"),
                    "openDashboard": L("대시보드 열기…", "Open dashboard…"),
                    "refresh": L("지금 새로고침", "Refresh now"),
                    "quit": L("Dipstick 종료", "Quit Dipstick"),
                    "binds": L("제약", "binds"),
                    "recovering": L("회복 임박", "recovering"),
                    "running": L("codex {n}개 실행 중", "{n} codex processes running"),
                    "updated": L("갱신 {t}", "updated {t}"),
                    "noReading": L("관측값 없음", "no reading yet"),
                    "subscriptions": L("구독", "subscriptions"),
                    "remaining": L("잔량", "Remaining"),
                    "pinnedMode": L("무조건 메인", "Pinned main"),
                    "nextLaunch": L("다음 발사", "Next launch"),
                    "runningSection": L("실행 중", "running"),
                    "notFound": L("dipstick CLI 를 찾을 수 없음", "dipstick CLI not found"),
                    "barWindowLabel": L("상단 표시", "Menu bar"),
                    "barBinds": L("제약", "binds"),
                    "bar5h": L("5시간", "5h"),
                    "bar7d": L("7일", "7d"),
                    "notifLowTitle": L("잔량 부족", "Running low"),
                    "notifBlockedTitle": L("잔량 소진", "Quota exhausted"),
                    "notifRecoveredTitle": L("회복됨", "Quota restored"),
                    "notifLowBody": L("{sub} · {win} {pct}% — 회복 {reset}",
                                      "{sub} · {win} {pct}% — recovers {reset}"),
                    "notifRecoveredBody": L("{sub} 다시 태울 수 있음 — {win} {pct}%",
                                            "{sub} is usable again — {win} {pct}%"),
                    "notifications": L("알림", "Alerts"),
                    "refreshing": L("동기화 중…", "syncing…"),
                    "syncedAt": L("동기화 {t}", "synced {t}"),
                    "syncFailed": L("동기화 실패 — 이전 값 표시 중", "sync failed — showing last values"),
                },
            }, ensure_ascii=False, indent=2))
            return 0
        if "--html" in args:
            i = args.index("--html")
            path = (args[i + 1] if len(args) > i + 1 and not args[i + 1].startswith("-")
                    else "quota.html")
            path = os.path.abspath(path)
            render_html(db, rows, consumers, path=path)
            print(f"wrote {path}\nopen: file://{path}")
            return 0
        render_text(db, rows, consumers)
        return 0
    finally:
        try:
            db.close()
        except Exception:
            pass


if __name__ == "__main__":
    sys.exit(main(sys.argv))
