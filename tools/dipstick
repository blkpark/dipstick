SCHEMA = """
CREATE TABLE IF NOT EXISTS scanned(
  ino INTEGER PRIMARY KEY, mtime REAL NOT NULL, ts TEXT, plan TEXT, payload TEXT);
CREATE TABLE IF NOT EXISTS samples(
  taken_at TEXT NOT NULL, sub TEXT NOT NULL, window TEXT NOT NULL,
  remaining REAL NOT NULL, resets_at TEXT);
CREATE INDEX IF NOT EXISTS samples_sub_time ON samples(sub, taken_at);
CREATE TABLE IF NOT EXISTS settings(key TEXT PRIMARY KEY, value TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS apicache(key TEXT PRIMARY KEY, fetched_at REAL NOT NULL, body TEXT);
-- Token spend, bucketed by hour. Local logs only: what this machine did.
CREATE TABLE IF NOT EXISTS tokens(
  vendor TEXT NOT NULL, sub TEXT NOT NULL, model TEXT NOT NULL DEFAULT '',
  hour TEXT NOT NULL,
  input INTEGER NOT NULL DEFAULT 0, output INTEGER NOT NULL DEFAULT 0,
  cache_read INTEGER NOT NULL DEFAULT 0, cache_write INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY(vendor, sub, model, hour));
-- Ingest bookmark per file: bytes already folded into `tokens`, so a growing
-- log is only ever read forward from where the last run stopped.
CREATE TABLE IF NOT EXISTS token_scan(
  ino INTEGER PRIMARY KEY, offset INTEGER NOT NULL, carry TEXT NOT NULL DEFAULT '');
"""

# The Claude usage endpoint rate-limits polling -- calling it once per run (let
# alone once per page refresh) earns a 429. Serve the cached body inside the TTL,
# and on any failure fall back to the last good one rather than losing the number.
CLAUDE_TTL = 300.0   # measured: this endpoint 429s well before a per-run poll


def connect():
    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
    db = sqlite3.connect(DB_PATH, timeout=10)
    # Token rows predating the model axis cannot be split after the fact, and a
    # per-model cap calibrated against every model's spend is worse than no
    # figure. The logs are still on disk, so the cheap fix is to re-read them.
    cols = [r[1] for r in db.execute("PRAGMA table_info(tokens)")]
    if cols and "model" not in cols:
        db.executescript("DROP TABLE tokens; DROP TABLE token_scan;")
    db.executescript(SCHEMA)
    return db


def get_setting(db, key, default=""):
    row = db.execute("SELECT value FROM settings WHERE key=?", (key,)).fetchone()
    return row[0] if row else default


def set_setting(db, key, value):
    db.execute("INSERT INTO settings(key,value) VALUES(?,?) "
               "ON CONFLICT(key) DO UPDATE SET value=excluded.value", (key, str(value)))
    db.commit()


def cache_get(db, key, ttl=None):
    """(body, age_seconds) or (None, None). ttl=None returns it at any age."""
    row = db.execute("SELECT fetched_at, body FROM apicache WHERE key=?", (key,)).fetchone()
    if not row:
        return None, None
    age = time.time() - row[0]
    if ttl is not None and age > ttl:
        return None, age
    try:
        return json.loads(row[1]), age
    except ValueError:
        return None, age


def cache_put(db, key, body):
    db.execute("INSERT INTO apicache(key,fetched_at,body) VALUES(?,?,?) "
               "ON CONFLICT(key) DO UPDATE SET fetched_at=excluded.fetched_at, "
               "body=excluded.body", (key, time.time(), json.dumps(body)))
    db.commit()


def _hour(ts):
    """ISO hour bucket in local time, or None if the stamp is unusable."""
    try:
        t = datetime.datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except (ValueError, AttributeError):
        return None
    return t.astimezone().replace(tzinfo=None, minute=0, second=0,
                                  microsecond=0).isoformat(timespec="hours")


def _fold(bucket, vendor, sub, model, hour, **counts):
    row = bucket.setdefault((vendor, sub, model, hour),
                            {"input": 0, "output": 0, "cache_read": 0, "cache_write": 0})
    for k, v in counts.items():
        row[k] += int(v or 0)


INGEST_BUDGET = 96 * 1024 * 1024   # bytes of log a single run may read
TOKEN_HISTORY_DAYS = 21            # keep a little past the widest window


def ingest_tokens(db):
    """Fold new log bytes into the hourly token table.

    Every file is read forward from a stored offset, so a session that keeps
    growing costs only its new bytes. The offset is committed with the counts it
    produced, which is what keeps a crash from double-counting a window.

    The run is also given a byte budget, because this sits behind the gauge: a
    first pass over months of logs is several gigabytes and once blocked every
    reading for eight minutes. Bookmarks make an interrupted pass resumable, so
    a bounded slice per run catches up over a few refreshes and no single one
    stalls. Newest files go first -- the current window is the part anyone is
    looking at.
    """
    budget = INGEST_BUDGET
    marks = {ino: (off, carry) for ino, off, carry
             in db.execute("SELECT ino,offset,carry FROM token_scan")}
    bucket, new_marks = {}, []

    # Only the recent past is ever read back: the widest window is seven days and
    # the spread is fitted over finished ones. Months of older rollouts are
    # gigabytes that nothing on screen would use.
    floor = (now - datetime.timedelta(days=TOKEN_HISTORY_DAYS)).timestamp()

    def newest(paths):
        out = []
        for f in paths:
            try:
                st = os.stat(f)
            except OSError:
                continue
            if st.st_mtime >= floor:
                out.append((st.st_mtime, f))
        return [f for _, f in sorted(out, reverse=True)]

    for path in newest(glob.glob(os.path.expanduser("~/.claude/projects/*/*.jsonl"))):
        if budget <= 0:
            break
        try:
            st = os.stat(path)
        except OSError:
            continue
        off, carry = marks.get(st.st_ino, (0, ""))
        if st.st_size < off:            # truncated or replaced: start over
            off, carry = 0, ""
        if st.st_size == off:
            continue
        try:
            with open(path, "rb") as fh:
                fh.seek(off)
                chunk = carry.encode() + fh.read(budget)
                read_to = fh.tell()
        except OSError:
            continue
        budget -= max(0, read_to - off)
        lines = chunk.split(b"\n")
        tail = lines.pop()              # last piece may be a half-written line
        for line in lines:
            if b'"usage"' not in line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            msg = d.get("message") or {}
            u = msg.get("usage") or {}
            hour = _hour(d.get("timestamp"))
            if not u or not hour:
                continue
            _fold(bucket, "claude", "Claude", msg.get("model") or "", hour,
                  input=u.get("input_tokens"), output=u.get("output_tokens"),
                  cache_read=u.get("cache_read_input_tokens"),
                  cache_write=u.get("cache_creation_input_tokens"))
        new_marks.append((st.st_ino, read_to, tail.decode("utf-8", "ignore")))

    # Codex writes a running total per session, so the per-turn cost is the
    # delta between records -- last_token_usage is the same number but is absent
    # from older rollouts, and a delta works for both.
    plan_of = {}
    for home in codex_homes():
        plan = None
        for f in glob.glob(os.path.join(home, "sessions", "*", "*", "*", "*.jsonl")):
            plan_of.setdefault(f, plan)
    for home in codex_homes():
        if budget <= 0:
            break
        for path in newest(glob.glob(os.path.join(home, "sessions", "*", "*", "*", "*.jsonl"))):
            if budget <= 0:
                break
            try:
                st = os.stat(path)
            except OSError:
                continue
            off, carry = marks.get(st.st_ino, (0, ""))
            if st.st_size < off:
                off, carry = 0, ""
            if st.st_size == off:
                continue
            try:
                with open(path, "rb") as fh:
                    fh.seek(off)
                    chunk = carry.encode() + fh.read(budget)
                    read_to = fh.tell()
            except OSError:
                continue
            budget -= max(0, read_to - off)
            lines = chunk.split(b"\n")
            tail = lines.pop()
            # Orca hardlinks session directories across Codex homes, so the same
            # rollout answers to a path under either account and the path cannot
            # say who spent it. The rate-limit records inside carry plan_type,
            # which is the same signal the gauge already separates accounts by.
            prev, model, plan = None, "", None
            for line in lines:
                if plan is None and b'"rate_limits"' in line:
                    try:
                        rec = json.loads(line)
                    except ValueError:
                        rec = None
                    if isinstance(rec, dict):
                        rl = (rec.get("payload") or {}).get("rate_limits") or {}
                        if rl.get("limit_id") == "codex" and rl.get("plan_type"):
                            plan = rl["plan_type"]
                if b'"model"' in line and b'"token_count"' not in line:
                    try:
                        seen = json.loads(line)
                    except ValueError:
                        seen = None
                    if isinstance(seen, dict):
                        found = (seen.get("payload") or {}).get("model") or seen.get("model")
                        if isinstance(found, str):
                            model = found
                if b'"token_count"' not in line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                info = (d.get("payload") or {}).get("info") or {}
                tot = info.get("total_token_usage") or {}
                hour = _hour(d.get("timestamp"))
                if not tot or not hour:
                    continue
                cur = {"input": tot.get("input_tokens", 0) - tot.get("cached_input_tokens", 0),
                       "output": tot.get("output_tokens", 0),
                       "cache_read": tot.get("cached_input_tokens", 0),
                       "cache_write": tot.get("cache_write_input_tokens", 0)}
                if prev is not None:
                    delta = {k: max(0, cur[k] - prev[k]) for k in cur}
                    _fold(bucket, "codex", sub_label("Codex", plan) if plan else codex_sub_of(path),
                          model or "", hour, **delta)
                prev = cur
            new_marks.append((st.st_ino, read_to, tail.decode("utf-8", "ignore")))

    if bucket:
        db.executemany(
            "INSERT INTO tokens(vendor,sub,model,hour,input,output,cache_read,cache_write) "
            "VALUES(?,?,?,?,?,?,?,?) ON CONFLICT(vendor,sub,model,hour) DO UPDATE SET "
            "input=input+excluded.input, output=output+excluded.output, "
            "cache_read=cache_read+excluded.cache_read, "
            "cache_write=cache_write+excluded.cache_write",
            [(v, sb, md, h, c["input"], c["output"], c["cache_read"], c["cache_write"])
             for (v, sb, md, h), c in bucket.items()])
    if new_marks:
        db.executemany(
            "INSERT INTO token_scan(ino,offset,carry) VALUES(?,?,?) "
            "ON CONFLICT(ino) DO UPDATE SET offset=excluded.offset, carry=excluded.carry",
            new_marks)
    # A run that stopped on the budget left logs unread, so the spend on screen
    # is short by an unknown amount. Estimates stay off until a pass finishes
    # with budget to spare -- an undercount would read as spare capacity, which
    # is the one direction a quota gauge must never be wrong in.
    set_setting(db, "tokens_complete", "1" if budget > 0 else "")
    db.commit()


def codex_sub_of(path):
    """Which Codex subscription a rollout belongs to, by the home it sits under."""
    for home, claims in _codex_claims():
        if path.startswith(home.rstrip("/") + "/"):
            plan = (claims.get("https://api.openai.com/auth") or {}).get("chatgpt_plan_type")
            if plan:
                return sub_label("Codex", plan)
    return "Codex"


def _token_key(sub):
    """Ingest cannot know the plan tier cheaply, so Claude spend is banked under
    a plain vendor key while the rows carry the labelled tier ("Claude Max")."""
    return "Claude" if sub.startswith("Claude") else sub


def tokens_since(db, sub, start):
    """Totals for one subscription from an hour boundary onward."""
    sub = _token_key(sub)
    row = db.execute(
        "SELECT COALESCE(SUM(input),0), COALESCE(SUM(output),0), "
        "COALESCE(SUM(cache_read),0), COALESCE(SUM(cache_write),0) "
        "FROM tokens WHERE sub=? AND hour>=?",
        (sub, start.replace(minute=0, second=0, microsecond=0).isoformat(timespec="hours"))
    ).fetchone()
    return {"input": row[0], "output": row[1], "cache_read": row[2], "cache_write": row[3]}


def hourly_tokens(db, sub, start):
    sub = _token_key(sub)
    return db.execute(
        "SELECT hour, input, output, cache_read, cache_write FROM tokens "
        "WHERE sub=? AND hour>=? ORDER BY hour",
        (sub, start.replace(minute=0, second=0, microsecond=0).isoformat(timespec="hours"))
    ).fetchall()


def cache_drop(db, key):
    db.execute("delete from cache where key=?", (key,))
    db.commit()


def record_samples(db, rows):
    db.executemany(
        "INSERT INTO samples(taken_at,sub,window,remaining,resets_at) VALUES(?,?,?,?,?)",
        [(now.isoformat(timespec="seconds"), r["sub"], w["name"], w["remaining"],
          w["resets"].isoformat() if w.get("resets") else None)
         for r in rows for w in r["windows"]])
    db.execute("DELETE FROM scanned WHERE mtime < ?", (time.time() - 30 * 86400,))
    db.execute("DELETE FROM samples WHERE taken_at < datetime('now','-30 days')")
    db.commit()


MIN_SPAN_H = 1.0    # below this the divisor is noise and the rate is meaningless


def burn_rate(db, sub, window, hours=48):
    """%p consumed per hour, or None until the samples span MIN_SPAN_H.

    A rise means the window reset, which is not consumption, so only falls count.
    """
    rows = db.execute(
        "SELECT taken_at, remaining FROM samples WHERE sub=? AND window=? "
        "AND taken_at >= datetime('now', ?) ORDER BY taken_at",
        (sub, window, f"-{hours} hours")).fetchall()
    if len(rows) < 2:
        return None
    spent = 0.0
    for (_, v0), (_, v1) in zip(rows, rows[1:]):
        if v1 < v0:
            spent += v0 - v1
    # Divide by the whole observed span, idle stretches included. Dividing by the
    # falling intervals alone looked right but overstated wildly: dense sampling
    # puts each fall in a seconds-long interval, and a day of reset cycles then
    # reads as hundreds of %p per hour.
    span = (datetime.datetime.fromisoformat(rows[-1][0])
            - datetime.datetime.fromisoformat(rows[0][0])).total_seconds() / 3600
    return spent / span if span >= MIN_SPAN_H else None


# -------------------------------------------------------------- collectors

def codex_homes():
    return [d for pat in CODEX_HOME_GLOBS
            for d in sorted(glob.glob(os.path.expanduser(pat))) if os.path.isdir(d)]


def _codex_claims():
    """[(home_dir, claims)] for every codex account found on this machine."""
    out = []
    for auth in [os.path.join(h, "auth.json") for h in codex_homes()]:
        try:
            tok = json.load(open(auth))["tokens"]["id_token"]
            body = tok.split(".")[1]
            out.append((os.path.dirname(auth),
                        json.loads(base64.urlsafe_b64decode(body + "=" * (-len(body) % 4)))))
        except Exception:
            continue
    return out


def codex_plan_to_email():
    """{plan_type: email}.

    Wrappers that manage several accounts may hardlink the session dir across
    homes, so the rollout stream interleaves every account and plan_type is the
    only separator. Two accounts on the same plan would collide.
    """
    out = {}
    for _, c in _codex_claims():
        plan = (c.get("https://api.openai.com/auth") or {}).get("chatgpt_plan_type")
        if plan:
            out[plan] = c.get("email", "?")
    return out


def codex_home_for(plan):
    for home, c in _codex_claims():
        if (c.get("https://api.openai.com/auth") or {}).get("chatgpt_plan_type") == plan:
            return home
    return None


SCAN_CHUNK = 8 * 1024 * 1024     # backwards-scan step
RESCAN_BYTES = 64 * 1024 * 1024  # how deep a changed, already-known file is rescanned


def _extract_rate_limits(path, max_bytes=None):
    """(ts, plan, payload) of the newest account-wide record in one rollout file.

    limit_id "codex" is the account limit. Other ids are per-model buckets
    (codex_bengalfox = GPT-5.3-Codex-Spark) which the desktop app also writes here;
    keying on plan_type alone turns those into phantom accounts.

    Rollouts run to gigabytes and the record wanted is the newest one, so the
    file is walked backwards in chunks and the walk stops at the first hit --
    reading a 1.4GB rollout front to back cost ~20s, paid on every refresh and
    by every shell that routes `codex` through --main-cmd. max_bytes bounds an
    incremental rescan: when the caller already holds a cached record, anything
    deeper than the cap is older than what it has.
    """
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            pos = fh.tell()
            floor = 0 if max_bytes is None else max(0, pos - max_bytes)
            carry = b""
            while pos > floor:
                step = min(SCAN_CHUNK, pos - floor)
                pos -= step
                fh.seek(pos)
                buf = fh.read(step) + carry
                lines = buf.split(b"\n")
                carry = lines[0]       # partial line; completed by the next chunk
                for line in reversed(lines[0 if pos == floor else 1:]):
                    if b'"rate_limits"' not in line:
                        continue
                    try:
                        d = json.loads(line)
                    except ValueError:
                        continue
                    rl = (d.get("payload") or {}).get("rate_limits")
                    if rl and d.get("timestamp") and rl.get("limit_id") == "codex":
                        return d["timestamp"], rl.get("plan_type"), rl
    except OSError:
        pass
    return None, None, None


def codex_rows(db, live_total):
    emails = codex_plan_to_email()
    cutoff = now - datetime.timedelta(days=14)
    cache = {ino: (mtime, ts, plan, payload) for ino, mtime, ts, plan, payload
             in db.execute("SELECT ino,mtime,ts,plan,payload FROM scanned")}

    fresh, best = [], {}
    for home in codex_homes():
        for f in glob.glob(os.path.join(home, "sessions", "*", "*", "*", "*.jsonl")):
            try:
                st = os.stat(f)
            except OSError:
                continue
            if datetime.datetime.fromtimestamp(st.st_mtime) < cutoff:
                continue
            hit = cache.get(st.st_ino)          # hardlinked across homes; ino dedupes
            if hit and abs(hit[0] - st.st_mtime) < 1e-6:
                ts, plan, payload = hit[1], hit[2], hit[3]
                rl = json.loads(payload) if payload else None
            else:
                # A file parsed before only needs its new tail: the cached record
                # is the newest the old content had, so if the fresh bytes carry
                # nothing newer the cache stays the answer. Only a never-seen
                # file earns an unbounded walk.
                ts, plan, rl = _extract_rate_limits(f, RESCAN_BYTES if hit else None)
                if rl is None and hit:
                    ts, plan = hit[1], hit[2]
                    rl = json.loads(hit[3]) if hit[3] else None
                fresh.append((st.st_ino, st.st_mtime, ts, plan,
                              json.dumps(rl) if rl else None))
            if rl and ts and (plan not in best or ts > best[plan][0]):
                best[plan] = (ts, rl)
    if fresh:
        db.executemany(
            "INSERT INTO scanned(ino,mtime,ts,plan,payload) VALUES(?,?,?,?,?) "
            "ON CONFLICT(ino) DO UPDATE SET mtime=excluded.mtime, ts=excluded.ts, "
            "plan=excluded.plan, payload=excluded.payload", fresh)
        db.commit()

    rows = []
    for plan, (ts, rl) in sorted(best.items(), key=lambda kv: str(kv[0])):
        obs = datetime.datetime.fromisoformat(
            ts.replace("Z", "+00:00")).astimezone().replace(tzinfo=None)
        stale = (now - obs).total_seconds() / 3600
        wins = []
        for key in ("primary", "secondary"):
            w = rl.get(key)
            if not w or w.get("used_percent") is None:
                continue
            remaining = 100 - float(w["used_percent"])
            resets = datetime.datetime.fromtimestamp(w["resets_at"]) if w.get("resets_at") else None
            sur = pace_surplus(remaining, w["window_minutes"], resets)
            wins.append({"name": window_label(w["window_minutes"]), "remaining": remaining,
                         "minutes": w["window_minutes"], "resets": resets, "surplus": sur,
                         "verdict": verdict(remaining, hours_until(resets) if resets else 0,
                                            stale, live_total, is_imminent(resets), sur)})
        rows.append({"sub": sub_label("Codex", plan), "account": emails.get(plan, "계정 미상"),
                     "pool": None, "windows": wins,
                     "note": L(f"관측 {obs:%m-%d %H:%M} ({stale:.0f}h 전)", f"seen {obs:%m-%d %H:%M} ({stale:.0f}h ago)")})
    for plan in sorted(set(emails) - set(best)):
        rows.append({"sub": sub_label("Codex", plan), "account": emails[plan], "pool": None,
                     "windows": [], "note": L("이 구독으로 아직 실행한 적 없어 관측값 없음", "no reading yet — nothing has run on this subscription")})
    return rows


def claude_account(db=None):
    """Best-known account email. `claude auth status` answers from the default
    keychain entry, which can be a logged-out stub while a wrapper's entry keeps
    the session alive -- so the last email that ever resolved is remembered and
    used when the live lookup comes back empty."""
    email = ""
    # ~/.claude.json keeps the account block even while the default keychain
    # entry is logged out, and reading it is free; `claude auth status` spawns
    # the CLI and answers only for the default entry.
    try:
        doc = json.load(open(os.path.expanduser("~/.claude.json")))
        email = (doc.get("oauthAccount") or {}).get("emailAddress") or ""
    except Exception:
        pass
    if not email:
        try:
            out = subprocess.run(["claude", "auth", "status", "--json"],
                                 capture_output=True, text=True, timeout=25).stdout
            email = json.loads(out).get("email") or ""
        except Exception:
            pass
    if db is not None:
        if email:
            set_setting(db, "claude_email", email)
        else:
            email = get_setting(db, "claude_email", "")
    return email or "계정 미상"


def claude_credentials():
    """(oauth, note). First usable credential across the known keychain entries.

    An entry can exist and still be logged out: the CLI leaves the record behind
    with an empty accessToken and expiresAt of 0. Reading that as "expired" sent
    people off to refresh a token that was never there, so an absent token and a
    stale one are told apart -- and a wrapper's own copy is tried before giving up,
    since the default entry is often the logged-out one.
    """
    found_any = False
    for service in CLAUDE_KEYCHAINS:
        account, raw = _keychain_read(service)
        if raw is False:
            return None, L("keychain 읽기 실패 (접근 승인 필요)",
                           "keychain read failed (access approval needed)")
        if not raw:
            continue
        found_any = True
        try:
            doc = json.loads(raw)
            oauth = doc["claudeAiOauth"]
        except (ValueError, KeyError):
            continue
        if oauth.get("accessToken"):
            return {"oauth": oauth, "doc": doc, "service": service, "account": account}, ""
    if not found_any:
        return None, L("keychain 항목 없음 또는 접근 거부", "no keychain entry, or access denied")
    return None, L("로그아웃 상태 — `claude auth login` 하면 읽힌다",
                   "logged out — run `claude auth login` and it will read")


def _keychain_read(service):
    """(account, payload). payload is False on a read failure, "" when absent."""
    try:
        find = subprocess.run(["security", "find-generic-password", "-g", "-s", service],
                              capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return "", False
    if find.returncode != 0:
        return "", ""
    account = ""
    for line in find.stderr.splitlines() + find.stdout.splitlines():
        if '"acct"' in line and '=' in line:
            account = line.split('=', 1)[1].strip().strip('"')
            break
    try:
        raw = subprocess.run(["security", "find-generic-password", "-w", "-s", service],
                             capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return account, False
    return account, (raw.stdout.strip() if raw.returncode == 0 else "")


def claude_refresh(cred):
    """Trade the refresh token for a live access token. Returns (oauth, note).

    The new credential is written back to the same keychain entry so the CLI and
    every other reader stay on one token -- the endpoint rotates the refresh token,
    and keeping the new one to ourselves would strand whoever refreshes next. The
    whole stored document is rewritten, not just the OAuth block: the default entry
    also carries every MCP server's tokens under mcpOAuth, and writing back a
    trimmed document would delete them.
    """
    oauth = cred["oauth"]
    token = oauth.get("refreshToken")
    if not token:
        return None, L("refresh token 없음 — `claude auth login` 필요",
                       "no refresh token — run `claude auth login`")
    expires = oauth.get("refreshTokenExpiresAt") or 0
    if expires and expires / 1000 < now.timestamp():
        return None, L("refresh token 만료 — `claude auth login` 필요",
                       "refresh token expired — run `claude auth login`")
    payload = json.dumps({"grant_type": "refresh_token", "refresh_token": token,
                          "client_id": CLAUDE_CLIENT_ID}).encode()
    req = urllib.request.Request(CLAUDE_TOKEN_URL, data=payload, headers={
        "Content-Type": "application/json", "User-Agent": "dipstick"})
    try:
        with urllib.request.urlopen(req, timeout=25) as r:
            fresh = json.load(r)
    except urllib.error.HTTPError as e:
        return None, L(f"토큰 갱신 실패 HTTP {e.code} — `claude auth login` 필요",
                       f"refresh failed HTTP {e.code} — run `claude auth login`")
    except Exception as e:
        return None, L(f"토큰 갱신 실패 {type(e).__name__}",
                       f"refresh failed: {type(e).__name__}")
    if not fresh.get("access_token"):
        return None, L("토큰 갱신 응답에 access_token 없음",
                       "refresh response carried no access_token")

    merged = dict(oauth)
    merged["accessToken"] = fresh["access_token"]
    if fresh.get("refresh_token"):
        merged["refreshToken"] = fresh["refresh_token"]
    if fresh.get("expires_in"):
        merged["expiresAt"] = int((now.timestamp() + float(fresh["expires_in"])) * 1000)
    doc = dict(cred["doc"])
    doc["claudeAiOauth"] = merged
    try:
        subprocess.run(["security", "add-generic-password", "-U",
                        "-s", cred["service"], "-a", cred["account"] or os.environ.get("USER", ""),
                        "-w", json.dumps(doc)],
                       capture_output=True, text=True, timeout=30, check=True)
    except Exception:
        # The live token still works for this run even if it could not be stored;
        # a gauge that refuses to read because it could not write is worse.
        cred["oauth"] = merged
        return merged, L("갱신됨 (keychain 저장 실패 — 이번 실행에만 적용)",
                         "refreshed (could not store it; applies to this run only)")
    cred["oauth"] = merged
    return merged, ""


def claude_rows(db):
    base = {"account": claude_account(db), "sub": "Claude", "pool": None, "windows": []}
    cred, err = claude_credentials()
    if err:
        return [dict(base, note=err)]
    oauth = cred["oauth"]

    base["sub"] = sub_label("Claude", oauth.get("subscriptionType"))
    note = ""
    expires = oauth.get("expiresAt") or 0
    if expires and expires / 1000 < now.timestamp():
        oauth, why = claude_refresh(cred)
        if oauth is None:
            return [dict(base, note=why)]
        note = why or L("토큰 갱신됨", "token refreshed")
        cache_drop(db, "claude_usage")
    body, age = cache_get(db, "claude_usage", CLAUDE_TTL)
    if body is None:
        req = urllib.request.Request(CLAUDE_USAGE_URL, headers={
            "Authorization": f"Bearer {oauth['accessToken']}",
            "anthropic-beta": "oauth-2025-04-20",
            "User-Agent": "claude-cli (quota gauge)"})
        try:
            with urllib.request.urlopen(req, timeout=25) as r:
                body = json.load(r)
            cache_put(db, "claude_usage", body)
        except Exception as e:
            # A 401 on a token that looked live means it was revoked or rotated
            # early; the stored expiry is a hint, not the authority.
            if getattr(e, "code", None) == 401:
                oauth, why = claude_refresh(cred)
                if oauth is not None:
                    req.add_header("Authorization", f"Bearer {oauth['accessToken']}")
                    try:
                        with urllib.request.urlopen(req, timeout=25) as r:
                            body = json.load(r)
                        cache_put(db, "claude_usage", body)
                        e = None
                        note = why or L("토큰 갱신됨", "token refreshed")
                    except Exception as again:
                        e = again
            if e is None:
                pass
            else:
                body, age = cache_get(db, "claude_usage")     # stale beats nothing
                reason = (f"HTTP {e.code}" if isinstance(e, urllib.error.HTTPError)
                          else type(e).__name__)
                if body is None:
                    hint = ("조회 한도 — 잠시 후 재시도" if getattr(e, "code", None) == 429
                            else "토큰 만료면 claude 재실행, 아니면 endpoint 변경 의심")
                    return [dict(base, note=f"{reason} — {hint}")]
                note = f"{reason} — 마지막 성공값 사용 ({age / 60:.0f}분 전)"
    elif age and age > 5:
        note = L(f"캐시 {age:.0f}초 전 (엔드포인트 폴링 한도 회피)", f"cached {age:.0f}s ago (endpoint rate-limits polling)")

    wins = []
    for key, mins in (("five_hour", 300), ("seven_day", 10080)):
        w = body.get(key)
        if not w or w.get("utilization") is None:
            continue
        remaining = 100 - float(w["utilization"])
        resets = (datetime.datetime.fromisoformat(w["resets_at"]).astimezone()
                  .replace(tzinfo=None)) if w.get("resets_at") else None
        sur = pace_surplus(remaining, mins, resets)
        wins.append({"name": window_label(mins), "remaining": remaining,
                     "minutes": mins, "resets": resets, "surplus": sur,
                     "verdict": verdict(remaining, hours_until(resets) if resets else 0,
                                        imminent=is_imminent(resets), surplus=sur)})
    # The limits array carries what the top-level fields do not: per-model weekly
    # caps ("weekly_scoped" with scope.model, e.g. Fable on Max plans). session and
    # weekly_all just mirror five_hour/seven_day, so only scoped entries are read.
    for lim in body.get("limits") or []:
        model = ((lim.get("scope") or {}).get("model") or {}).get("display_name")
        if not model or lim.get("percent") is None:
            continue
        remaining = 100 - float(lim["percent"])
        resets = (datetime.datetime.fromisoformat(lim["resets_at"]).astimezone()
                  .replace(tzinfo=None)) if lim.get("resets_at") else None
        group = lim.get("group") or ""
        name = window_label(10080) if group == "weekly" else (
            window_label(300) if group == "session" else group or "?")
        mins2 = 10080 if group == "weekly" else 300 if group == "session" else None
        sur = pace_surplus(remaining, mins2, resets)
        wins.append({"name": f"{model} · {name}", "remaining": remaining,
                     "minutes": mins2, "resets": resets, "surplus": sur,
                     "verdict": verdict(remaining, hours_until(resets) if resets else 0,
                                        imminent=is_imminent(resets), surplus=sur)})
    return [dict(base, windows=wins, note=note)]


def agy_rows():
    """agy holds quota in memory and serves it on a per-process local port."""
    try:
        acct = json.load(open(GOOGLE_ACCOUNTS)).get("active") or "계정 미상"
    except Exception:
        acct = "계정 미상"
    base = {"account": acct, "sub": "Antigravity", "pool": None, "windows": []}
    try:
        out = subprocess.run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN"],
                             capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.TimeoutExpired):
        return [dict(base, note="포트 탐색 실패")]
    ports = [int(m.group(1)) for line in out.splitlines() if line.split()[:1] == ["agy"]
             for m in [re.search(r"127\.0\.0\.1:(\d+)", line)] if m]
    if not ports:
        return [dict(base, note=L("실행 중인 agy 없음 — 하나 띄우면 조회됨", "no agy running — start one and it reads"))]

    body = None
    for p in sorted(ports, reverse=True):
        req = urllib.request.Request(f"http://127.0.0.1:{p}{AGY_RPC}", data=b"{}",
                                     headers={"Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=6) as r:
                body = json.load(r)
            break
        except Exception:
            continue
    if not body:
        return [dict(base, note="로컬 RPC 응답 없음")]

    rows = []
    for g in body.get("response", {}).get("groups", []):
        wins = []
        for b in g.get("buckets", []):
            frac = b.get("remainingFraction")
            if frac is None:
                continue
            remaining = float(frac) * 100
            resets = (datetime.datetime.fromisoformat(b["resetTime"].replace("Z", "+00:00"))
                      .astimezone().replace(tzinfo=None)) if b.get("resetTime") else None
            label = AGY_WINDOW.get(b.get("window"))
            mins3 = AGY_MINUTES.get(b.get("window"))
            sur = pace_surplus(remaining, mins3, resets)
            wins.append({"name": label() if label else b.get("displayName", "?"),
                         "remaining": remaining, "minutes": mins3, "resets": resets,
                         "surplus": sur,
                         "verdict": verdict(remaining, hours_until(resets) if resets else 0,
                                            imminent=is_imminent(resets), surplus=sur)})
        gname = AGY_GROUP.get(g.get("displayName"))
        rows.append(dict(base, pool=gname() if gname else g.get("displayName"),
                         windows=wins, note=""))
    return rows


def live_codex():
    counts = collections.Counter()
    try:
        pids = subprocess.run(["pgrep", "-x", "codex"], capture_output=True, text=True).stdout.split()
    except OSError:
        return counts
    for pid in pids:
        env = subprocess.run(["ps", "eww", "-o", "command=", "-p", pid],
                             capture_output=True, text=True).stdout
        m = re.search(r"CODEX_HOME=(\S+(?: \S+)*?)(?= [A-Z_]+=|$)", env)
        counts[m.group(1) if m else "(unset → ~/.codex)"] += 1
    return counts


def collect(db):
    consumers = live_codex()
    rows = codex_rows(db, sum(consumers.values())) + claude_rows(db) + agy_rows()
    record_samples(db, rows)
    try:
        ingest_tokens(db)
    except Exception:
        pass        # token history is a detail view; never let it block the gauge
    return rows, consumers


def group_by_subscription(rows, main=""):
    """[(sub, account, [row,...]), ...] -- one quota pool per group.

    Subscription, not e-mail: one address can hold several unrelated subscriptions
    (a Claude plan and an Antigravity plan can share one address) whose quotas
    never share a pool. The main pins to the top; the rest sort tightest-first so
    whatever can block a lane is read early.
    """
    groups = collections.OrderedDict()
    for r in rows:
        groups.setdefault(r.get("sub", "?"), []).append(r)
    out = [(sub, g[0].get("account", "계정 미상"), g) for sub, g in groups.items()]

    def key(entry):
        return (0 if entry[0] == main else 1,
                binding_score([w for r in entry[2] for w in r["windows"]]))
    return sorted(out, key=key)


BAR_WINDOWS = ("binds", "5h", "7d")   # what the menu bar leads with

MAIN_BONUS = 10.0    # %p of stickiness: the main keeps the launch unless clearly worse


def launch_prefix(sub):
    if sub.startswith("Antigravity"):
        # One account, no home juggling -- the prefix is just the CLI. `command`
        # for the same reason as the others: survive an eval inside a shell
        # function that shadows `agy`.
        return "command agy --dangerously-skip-permissions", ""
    if sub.startswith("Claude"):
        # `command` for the same reason as codex below: the prefix must survive
        # being eval'd inside a shell function that shadows `claude`.
        return "command claude --permission-mode bypassPermissions", ""
    home = codex_home_for(sub.split()[-1].lower())
    if not home:
        return None, L(f"{sub}: codex 홈을 못 찾음", f"{sub}: no codex home found")
    # `command` so the prefix still works when eval'd inside a shell function
    # that itself shadows `codex` -- without it the function recurses forever.
    return f'env CODEX_HOME="{home}" command codex', ""


def sub_score(group):
    """Worst pace surplus across the subscription's lasting windows."""
    wins = binding_windows([w for r in group for w in r["windows"]])
    vals = [w["surplus"] for w in wins if w.get("surplus") is not None]
    if vals:
        return min(vals)
    rem = [w["remaining"] for w in wins]
    return (min(rem) - 70.0) if rem else None    # no reset clock: rough proxy


VENDOR_PREFIX = {"codex": "Codex", "claude": "Claude", "agy": "Antigravity"}


def pick_launch(db, rows, vendor=None):
    """(sub, why). Which subscription a new launch should burn.

    pinned: always the main -- one subscription takes everything.
    weighted: the best pace among subscriptions that are free to burn. A reserve
    floor means "kept for its own use", so those never enter unless they ARE the
    main; naming one as main is the explicit opt-in. The main gets MAIN_BONUS of
    stickiness so a marginal difference never flips the account mid-day.

    vendor pins the TOOL: `--vendor codex` answers "which codex account", never
    swapping in another vendor's CLI. If the pinned main is a different vendor,
    the pin cannot be honoured for this call, so it falls back to the best pace
    within the vendor -- the user's typed command wins over the pin.
    """
    main = get_setting(db, "main")
    mode = get_setting(db, "main_mode", "weighted")
    prefix = VENDOR_PREFIX.get(vendor or "")
    if vendor and not prefix:
        return None, f"unknown vendor: {vendor}"

    # The pin is absolute for dispatch, scoped for typed commands. An anonymous
    # pick is "run this work somewhere" -- everything goes to the pinned pool,
    # overriding the pace pick and the reserve floor; concentrating spend is the
    # point of the mode. A typed vendor is different: the human already chose the
    # tool, and answering with another vendor's CLI would not concentrate spend,
    # it would replace the command. There the pin applies only when it names the
    # same vendor; otherwise the pick stays inside the vendor asked for.
    if mode == "pinned" and main and (not prefix or main.startswith(prefix)):
        return main, L("고정 모드 — 전량 집중", "pinned — everything goes here")
    if not main and not prefix:
        return None, L("메인 미지정 — --set-main 으로 정한다",
                       "no main set — choose one with --set-main")

    best, best_score = None, None
    for sub, _, group in group_by_subscription(rows, main):
        if sub.startswith("Antigravity") and prefix != "Antigravity":
            # Out of the anonymous pick -- agy is role-fixed (research), so
            # @main never rides it. Asking for it by name (--vendor agy) is the
            # role doing exactly what it is fixed to do, and must resolve.
            continue
        if prefix and not sub.startswith(prefix):
            continue                               # the typed command fixes the vendor
        if reserve_floor(sub) is not None and sub != main and not prefix:
            # Reserved pools stay out of the anonymous (@main) pick unless they
            # ARE the main. A typed vendor is different: the reserve exists to
            # protect the human's own use of that tool from background lanes,
            # and the human typing the command IS that protected use.
            continue
        score = sub_score(group)
        if score is None:
            continue
        if sub == main:
            score += MAIN_BONUS
        if best_score is None or score > best_score:
            best, best_score = sub, score
    if best is None:
        fallback = main if (not prefix or (main or "").startswith(prefix)) else None
        return fallback, L("후보 관측값 없음", "no candidate readings")
    if prefix and mode == "pinned":
        tag = L(f"벤더 고정({vendor}) — 핀({main})은 다른 벤더, 벤더 내 최적 계정",
                f"vendor-fixed ({vendor}) — pin ({main}) is another vendor; best within")
    elif best == main:
        tag = L("가중 선택", "weighted pick")
    else:
        tag = L(f"가중 선택 — 메인({main}) 대신", f"weighted pick — over main ({main})")
    return best, tag


def main_launch_cmd(db, rows, vendor=None):
    """(command_prefix, error, warning). Empty error means safe to launch."""
    sub, _why = pick_launch(db, rows, vendor)
    if not sub:
        return None, L("메인 미지정 — --set-main 으로 정한다",
                       "no main set — choose one with --set-main"), ""
    wins = [w for r in rows if r["sub"] == sub for w in r["windows"]]
    floor = reserve_floor(sub)
    warn = ""
    if floor is not None:
        if not wins:
            return None, L(f"{sub}: 관측값 없어 하한 {floor:.0f}% 확인 불가 — BLOCKED",
                           f"{sub}: no reading, cannot check the {floor:.0f}% floor — BLOCKED"), ""
        low = min(w["remaining"] for w in wins)
        if low < floor:
            warn = f"{sub} {low:.0f}% < {floor:.0f}%"
    prefix, err = launch_prefix(sub)
    if err:
        return None, err, ""
    return prefix, "", warn


