def apply_lang(db, override=None):
    global LANG
    LANG = override or get_setting(db, "lang", "ko") or "ko"
    if LANG not in ("ko", "en"):
        LANG = "ko"


MIN_CALIB_PCT = 15.0   # below this the ratio divides by noise, so no estimate
MAX_SPREAD = 1.0       # past windows disagreeing by more than this: show no number


MIN_FIT = 0.7           # R² below this and per-model weights are not worth quoting
MIN_BLEND_FIT = 0.4     # and below this even a blended range is not worth quoting
MIN_MODEL_SHARE = 0.02  # models under this share of spend are noise in the fit


def model_weights(db, sub, window, minutes, blended=False):
    """Per-model %p-per-million-tokens for one window, or None if the fit is weak.

    Models do not drain a window at the same rate, so one blended ratio answers
    a question nobody asked: how much is left depends on what you run next.
    Solved per model instead, non-negative -- a model that consumes quota cannot
    give it back, and an unconstrained fit happily returns negative weights.

    The fit is scored against the same hours it was built from and withheld
    below MIN_FIT. Measured here: Codex ProLite lands at 0.93, Claude's 7-day
    window at 0.46, and the five-hour window near zero, which is the difference
    between a figure worth showing and one worth refusing.
    """
    key = _token_key(sub)
    rows = db.execute("SELECT model, SUM(input+output+cache_read+cache_write) FROM tokens "
                      "WHERE sub=? AND model!='' GROUP BY model", (key,)).fetchall()
    total = sum(v for _, v in rows) or 1
    models = [m for m, v in sorted(rows, key=lambda r: -r[1]) if v / total >= MIN_MODEL_SHARE]
    if not models:
        return None
    spend = {m: dict(db.execute(
        "SELECT hour, input+output+cache_read+cache_write FROM tokens WHERE sub=? AND model=?",
        (key, m))) for m in models}

    # Utilisation lost in each clock hour, from the readings taken during it.
    per_hour, prev, drops = {}, None, {}
    for taken, rem in db.execute("SELECT taken_at, remaining FROM samples "
                                 "WHERE sub=? AND window=? ORDER BY taken_at", (sub, window)):
        e = per_hour.setdefault(taken[:13], [rem, rem])
        e[1] = rem
    for hour in sorted(per_hour):
        first, last = per_hour[hour]
        if prev is not None:
            d = (prev - first) + (first - last)
            if 0 < d < 40:      # a reset shows up as a jump, not a drop
                drops[hour] = d
        prev = last

    X, y = [], []
    for hour, d in drops.items():
        row = [spend[m].get(hour, 0) / 1e6 for m in models]
        if sum(row) > 0:
            X.append([sum(row)] if blended else row)
            y.append(d)
    if len(X) < 20:
        return None

    if blended:
        models = ["*"]
    n = len(models)
    w = [0.0] * n
    for _ in range(200):        # coordinate descent, clamped at zero
        for i in range(n):
            num = den = 0.0
            for k, row in enumerate(X):
                resid = y[k] - sum(w[j] * row[j] for j in range(n) if j != i)
                num += row[i] * resid
                den += row[i] * row[i]
            w[i] = max(0.0, num / den) if den > 1e-12 else 0.0
    mean = sum(y) / len(y)
    denom = sum((v - mean) ** 2 for v in y)
    if denom <= 0:
        return None
    err = sum((y[k] - sum(w[i] * X[k][i] for i in range(n))) ** 2 for k in range(len(X)))
    r2 = 1 - err / denom
    if r2 < (MIN_BLEND_FIT if blended else MIN_FIT):
        return None
    return {"r2": r2, "weights": [(m, v) for m, v in zip(models, w) if v > 0]}


def calibration_spread(db, sub, window, minutes):
    """How much tokens-per-percent has varied across finished windows.

    The point of measuring it is knowing when not to answer. Neither vendor
    publishes how a window's capacity is spent, so the only honest conversion is
    one fitted from past windows -- and the fit is worth showing only if past
    windows agreed. Measured here: 7-day windows land near 0.6, five-hour windows
    near 2.2, which is why the short window shows spend and no estimate.
    """
    key = _token_key(sub)
    seen, ratios = set(), []
    rows = db.execute("SELECT taken_at, remaining, resets_at FROM samples "
                      "WHERE sub=? AND window=? ORDER BY taken_at", (sub, window)).fetchall()
    by_reset = {}
    for _, rem, reset in rows:
        if reset:
            by_reset[reset] = rem      # last reading of each window
    for reset, rem in by_reset.items():
        used = 100.0 - rem
        if used < MIN_CALIB_PCT:
            continue
        try:
            end = datetime.datetime.fromisoformat(reset).replace(tzinfo=None)
        except ValueError:
            continue
        start = (end - datetime.timedelta(minutes=minutes)).replace(
            minute=0, second=0, microsecond=0)
        got = db.execute(
            "SELECT COALESCE(SUM(input+output+cache_read+cache_write),0) FROM tokens "
            "WHERE sub=? AND hour>=? AND hour<?",
            (key, start.isoformat(timespec="hours"), end.isoformat(timespec="hours"))
        ).fetchone()[0]
        if got > 0:
            ratios.append(got / used)
    if len(ratios) < 4:
        return None
    mean = sum(ratios) / len(ratios)
    if mean <= 0:
        return None
    var = sum((r - mean) ** 2 for r in ratios) / len(ratios)
    return (var ** 0.5) / mean


def token_view(db, sub, windows):
    """Per-window token spend and, where it can be trusted, what is left.

    The server's weighting is not published, so the ratio is fitted per window
    instead of assumed: tokens this machine logged since the window opened,
    divided by the percent the server says was consumed. It self-corrects for
    spend this machine cannot see -- usage from the web app or another host
    inflates the denominator and the ratio absorbs it -- as long as that share
    holds steady. Early in a window the percent is small and the division is
    mostly noise, so the estimate is withheld rather than guessed.
    """
    out = []
    for w in windows:
        if not w.get("resets") or not w.get("minutes"):
            continue
        start = w["resets"] - datetime.timedelta(minutes=w["minutes"])
        spent = tokens_since(db, sub, start)
        total = sum(spent.values())
        used_pct = 100.0 - w["remaining"]
        est = per_pct = lo = hi = None
        complete = bool(get_setting(db, "tokens_complete", ""))
        blend = (model_weights(db, sub, w["name"], w["minutes"], blended=True)
                 if complete else None)
        spread = (calibration_spread(db, sub, w["name"], w["minutes"])
                  if complete and blend else None)
        if complete and blend and used_pct >= MIN_CALIB_PCT and total > 0:
            per_pct = total / used_pct
            if spread is not None and spread <= MAX_SPREAD:
                est = per_pct * w["remaining"]
                lo, hi = est * max(0.05, 1 - spread), est * (1 + spread)
        billable = spent["input"] + spent["output"] + spent["cache_write"]
        fit = model_weights(db, sub, w["name"], w["minutes"]) if complete else None
        per_model = []
        if fit:
            for name, weight in sorted(fit["weights"], key=lambda t: t[1]):
                if weight > 0:
                    per_model.append((name, w["remaining"] / weight * 1e6))
        out.append({"window": w, "spent": spent, "total": total, "billable": billable,
                    "fit": fit, "per_model": per_model,
                    "cache_pct": (spent["cache_read"] / total * 100) if total else 0.0,
                    "per_pct": per_pct, "estimate": est, "lo": lo, "hi": hi,
                    "complete": complete,
                    "spread": spread, "used_pct": used_pct, "start": start,
                    "hours": hourly_tokens(db, sub, start)})
    return out


def human_tokens(n):
    for unit, size in (("B", 1e9), ("M", 1e6), ("K", 1e3)):
        if n >= size:
            return f"{n / size:.1f}{unit}"
    return f"{n:.0f}"


def spark(hours, minutes):
    """Hourly spend as an inline bar chart.

    Bars, not a line: the buckets are discrete hours, and a line between them
    would imply a rate that was never measured. Every bar carries its own title
    so the exact figure is reachable without a tooltip library, and the whole
    chart carries a text summary for readers that never see it.
    """
    if not hours:
        return ""
    vals = [(h[0], h[1] + h[2] + h[3] + h[4]) for h in hours]
    peak = max(v for _, v in vals) or 1
    step = max(1, len(vals) // 60)          # keep bars legible on a 7-day window
    if step > 1:
        merged = []
        for i in range(0, len(vals), step):
            chunk = vals[i:i + step]
            merged.append((chunk[0][0], sum(v for _, v in chunk)))
        vals, peak = merged, max(v for _, v in merged) or 1
    w, gap = 100.0 / max(len(vals), 1), 0.18
    bars = []
    for i, (hour, v) in enumerate(vals):
        h = max(1.5, v / peak * 100)
        label = hour[11:16] if minutes <= 1440 else hour[5:10]
        bars.append(f'<rect x="{i * w + w * gap / 2:.3f}" y="{100 - h:.2f}" '
                    f'width="{w * (1 - gap):.3f}" height="{h:.2f}" rx="0.4">'
                    f'<title>{label} · {human_tokens(v)}</title></rect>')
    first = vals[0][0][5:16].replace("T", " ")
    last = vals[-1][0][5:16].replace("T", " ")
    summary = L(f"{first}부터 {last}까지 시간대별 토큰, 최대 {human_tokens(peak)}",
                f"tokens by hour from {first} to {last}, peak {human_tokens(peak)}")
    return (f'<svg class="spark" viewBox="0 0 100 100" preserveAspectRatio="none" '
            f'role="img" aria-label="{esc(summary)}">{"".join(bars)}</svg>'
            f'<div class="axis"><span>{esc(first)}</span>'
            f'<span>{L("최대", "peak")} {human_tokens(peak)}</span>'
            f'<span>{esc(last)}</span></div>')


def render_html(db, rows, consumers, path=None, interactive=False):
    main = get_setting(db, "main")
    groups = group_by_subscription(rows, main)
    states = [w["verdict"][0] for _, _, g in groups
              for w in binding_windows([w2 for r in g for w2 in r["windows"]])]
    # a subscription with no readable window is UNKNOWN, not "여유"
    states += ["UNKNOWN" for _, _, g in groups if not any(r["windows"] for r in g)]
    worst = next((s for s in STATE_ORDER if s in states), "UNKNOWN")
    worst_text = {
        "GO": L("모든 구독 여유", "every subscription has headroom"),
        "TIGHT": L("일부 구독 빠듯 — 긴 작업 주의", "some are tight — mind long jobs"),
        "LOW": L("잔량 부족 구독 있음", "a subscription is running low"),
        "BLOCKED": L("소진된 구독 있음", "a subscription is exhausted"),
        "STALE": L("관측이 오래된 구독 있음", "a reading is stale"),
        "UNKNOWN": L("못 읽은 구독 있음 — 카드 확인", "a subscription could not be read"),
    }[worst]
    selectable = {sub for sub, _, _ in groups if not sub.startswith("Antigravity")}

    # the subscription being burned below its own reserve floor, if any. This is
    # surfaced here rather than on stderr: --main-cmd runs inside a command
    # substitution, where a warning is swallowed by the launch line.
